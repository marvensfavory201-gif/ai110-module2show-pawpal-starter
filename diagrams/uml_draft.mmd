classDiagram
    class Owner {
        +String name
        +String email
        +List~Pet~ pets
        +add_pet(pet: Pet)
        +get_all_tasks_across_pets() List~Dict~
    }

    class Pet {
        +String name
        +String breed
        +int age
        +List~Task~ tasks
        +add_task(task: Task)
    }

    class Task {
        +String description
        +int time
        +String frequency
        +String start_time
        +bool is_completed
        +String priority
        +date due_date
        +mark_complete(pet: Pet)
        +to_dict() Dict
    }

    class Scheduler {
        +int allocated_time
        +List~String~ reasoning_log
        +List~String~ conflicts
        +sort_by_time(tasks: List) List
        +filter_tasks(tasks: List, exclude_completed: bool, pet_name: str) List
        +detect_conflicts(scheduled_plan: List)
        +generate_daily_plan(owner: Owner, available_time_budget: int) List~Dict~
        +get_reasoning_summary() String
    }

    Owner "1" --> "0..*" Pet : manages
    Pet "1" --> "0..*" Task : aggregates
    Scheduler ..> Owner : requests data from
    Scheduler ..> Task : mutates state via mark_complete
